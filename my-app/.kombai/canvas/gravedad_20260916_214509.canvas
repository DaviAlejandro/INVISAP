      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n@layer components { .severity-one .bi {display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;color:currentColor} .severity-one button {cursor:default} .severity-one .row-action {display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:8px;color:#627169} .severity-one .row-action:hover {background:#edf5ed;color:#2e7d32} .severity-one .sample-row:last-child {border-bottom:0} }\n</style>\n<div class=\"severity-one min-h-[780px] bg-[#f5f6f8] px-4 py-6 text-[#1a1a1a] sm:px-8 sm:py-10\" data-kid=\"1\" style=\"font-family:'Public Sans',sans-serif\">\n    <main class=\"mx-auto w-full max-w-[1440px] min-w-0\" data-kid=\"1-1\">\n        <div class=\"mb-6 flex items-center gap-2 text-xs text-[#69746f]\" data-kid=\"1-1-1\">\n            <span class=\"font-bold tracking-[0.12em] text-[#2e7d32]\" data-kid=\"1-1-1-1\">\n                INVISAP\n            </span>\n            <span class=\"h-3 w-px bg-[#d9dfdb]\" data-kid=\"1-1-1-2\">\n            </span>\n            <span data-kid=\"1-1-1-3\">\n                Catálogos\n            </span>\n            <i class=\"bi bi-chevron-right\" data-kid=\"1-1-1-4\" style=\"width:12px;height:12px\">\n            </i>\n            <span data-kid=\"1-1-1-5\">\n                Gravedad de obra\n            </span>\n        </div>\n        <header class=\"mb-8 flex flex-wrap items-center justify-between gap-5\" data-kid=\"1-1-2\">\n            <div class=\"min-w-0\" data-kid=\"1-1-2-1\">\n                <div class=\"mb-2 flex items-center gap-2 text-xs font-semibold text-[#2e7d32]\" data-kid=\"1-1-2-1-1\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#2e7d32]\" data-kid=\"1-1-2-1-1-1\">\n                    </span>\n                    CLASIFICACIÓN DE OBRAS\n                </div>\n                <h1 class=\"text-[clamp(1.4rem,2.3vw,1.9rem)] font-bold leading-tight tracking-[-0.035em]\" data-kid=\"1-1-2-1-2\">\n                    Gestión de Gravedad de la Obra\n                </h1>\n                <p class=\"mt-2 max-w-[620px] text-sm leading-6 text-[#65716b]\" data-kid=\"1-1-2-1-3\">\n                    Administra los niveles que clasifican la criticidad de tus proyectos y obras.\n                </p>\n            </div>\n            <button class=\"flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#2e7d32] px-5 py-3 text-sm font-semibold text-white sm:w-auto\" data-kid=\"1-1-2-2\">\n                <i class=\"bi bi-plus-lg\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Nuevo nivel\n            </button>\n        </header>\n        <div class=\"grid min-w-0 grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_280px]\" data-kid=\"1-1-3\">\n            <section class=\"min-w-0 overflow-hidden rounded-2xl border border-[#dfe5e1] bg-white\" data-kid=\"1-1-3-1\">\n                <div class=\"flex flex-wrap items-center justify-between gap-3 px-5 pt-6 sm:px-6\" data-kid=\"1-1-3-1-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-1-1-1\">\n                        <h2 class=\"text-lg font-bold tracking-tight\" data-kid=\"1-1-3-1-1-1-1\">\n                            Listado de Niveles\n                        </h2>\n                        <span class=\"rounded-md bg-[#eef3ee] px-2 py-1 text-xs font-semibold text-[#47634d]\" data-kid=\"1-1-3-1-1-1-2\">\n                            2\n                        </span>\n                    </div>\n                    <span class=\"text-xs text-[#778179]\" data-kid=\"1-1-3-1-1-2\">\n                        Vista de ejemplo\n                    </span>\n                </div>\n                <div class=\"flex flex-wrap items-end gap-3 border-b border-[#e6ebe7] p-5 sm:px-6\" data-kid=\"1-1-3-1-2\">\n                    <div class=\"min-w-0 grow\" data-kid=\"1-1-3-1-2-1\">\n                        <label class=\"mb-2 block text-xs font-semibold text-[#53625a]\" data-kid=\"1-1-3-1-2-1-1\" for=\"s1-search\">\n                            Buscar nivel\n                        </label>\n                        <div class=\"flex h-11 items-center gap-2 rounded-lg border border-[#dce3de] px-3 text-[#7c8780]\" data-kid=\"1-1-3-1-2-1-2\">\n                            <i class=\"bi bi-search shrink-0\" data-kid=\"1-1-3-1-2-1-2-1\">\n                            </i>\n                            <input class=\"min-w-0 w-full bg-transparent text-sm text-[#34483a] outline-hidden\" data-kid=\"1-1-3-1-2-1-2-2\" id=\"s1-search\" placeholder=\"Nivel o criticidad…\"/>\n                        </div>\n                    </div>\n                    <button class=\"flex h-11 items-center gap-2 rounded-lg border border-[#dce3de] px-3 text-sm font-medium text-[#526157]\" data-kid=\"1-1-3-1-2-2\">\n                        <i class=\"bi bi-arrow-clockwise\" data-kid=\"1-1-3-1-2-2-1\">\n                        </i>\n                        Actualizar\n                    </button>\n                </div>\n                <div class=\"hidden sm:block\" data-kid=\"1-1-3-1-3\">\n                    <table class=\"w-full text-left text-sm\" data-kid=\"1-1-3-1-3-1\">\n                        <thead class=\"bg-[#f8faf8] text-[11px] font-semibold tracking-[0.05em] text-[#68776d] uppercase\" data-kid=\"1-1-3-1-3-1-1\">\n                            <tr data-kid=\"1-1-3-1-3-1-1-1\">\n                                <th class=\"py-3 pl-6 pr-2\" data-kid=\"1-1-3-1-3-1-1-1-1\">\n                                    ID\n                                </th>\n                                <th class=\"px-2 py-3\" data-kid=\"1-1-3-1-3-1-1-1-2\">\n                                    Nivel de gravedad\n                                </th>\n                                <th class=\"px-2 py-3\" data-kid=\"1-1-3-1-3-1-1-1-3\">\n                                    Criticidad\n                                </th>\n                                <th class=\"px-2 py-3\" data-kid=\"1-1-3-1-3-1-1-1-4\">\n                                    Estado\n                                </th>\n                                <th class=\"py-3 pr-5 pl-2 text-right\" data-kid=\"1-1-3-1-3-1-1-1-5\">\n                                    Acciones\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-dynamic=\"true\" data-kid=\"1-1-3-1-3-1-2\" data-name=\"list of project severity levels table body\" data-reason=\"table rows generated and injected by script\" id=\"s1-rows\">\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"divide-y divide-[#e6ebe7] sm:hidden\" data-dynamic=\"true\" data-kid=\"1-1-3-1-4\" data-name=\"list of project severity levels mobile view\" data-reason=\"card elements generated and injected by script\" id=\"s1-mobile\">\n                </div>\n                <div class=\"flex flex-wrap items-center justify-between gap-2 border-t border-[#e6ebe7] px-5 py-4 text-xs text-[#6f7b72] sm:px-6\" data-kid=\"1-1-3-1-5\">\n                    <span data-kid=\"1-1-3-1-5-1\">\n                        2 registros de ejemplo\n                    </span>\n                    <span data-kid=\"1-1-3-1-5-2\">\n                        Criticidad expresada en porcentaje\n                    </span>\n                </div>\n            </section>\n            <aside class=\"min-w-0 rounded-2xl border border-[#dfe5e1] bg-white p-5\" data-kid=\"1-1-3-2\">\n                <div class=\"flex items-center gap-2 text-[#2e7d32]\" data-kid=\"1-1-3-2-1\">\n                    <i class=\"bi bi-speedometer2\" data-kid=\"1-1-3-2-1-1\">\n                    </i>\n                    <h2 class=\"text-sm font-bold text-[#263a2c]\" data-kid=\"1-1-3-2-1-2\">\n                        Guía de gravedad\n                    </h2>\n                </div>\n                <p class=\"mt-2 text-xs leading-5 text-[#718077]\" data-kid=\"1-1-3-2-2\">\n                    Consulta los rangos de clasificación.\n                </p>\n                <div class=\"my-6 flex justify-center\" data-kid=\"1-1-3-2-3\">\n                    <div class=\"flex h-[150px] w-[150px] items-center justify-center rounded-full\" data-kid=\"1-1-3-2-3-1\" style=\"background:conic-gradient(from 0deg,#c74e46 0deg 178deg,#fff 178deg 182deg,#2e7d32 182deg 358deg,#fff 358deg)\">\n                        <div class=\"flex h-[128px] w-[128px] flex-col items-center justify-center rounded-full bg-white\" data-kid=\"1-1-3-2-3-1-1\">\n                            <strong class=\"text-[36px] leading-none tracking-tight\" data-kid=\"1-1-3-2-3-1-1-1\">\n                                2\n                            </strong>\n                            <span class=\"mt-2 text-xs text-[#66766c]\" data-kid=\"1-1-3-2-3-1-1-2\">\n                                niveles de gravedad\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-1-3-2-4\">\n                    <div class=\"flex items-center justify-between rounded-lg bg-[#f0f7f0] px-3 py-3\" data-kid=\"1-1-3-2-4-1\">\n                        <span class=\"flex items-center gap-2 text-sm font-semibold text-[#2e7d32]\" data-kid=\"1-1-3-2-4-1-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#2e7d32]\" data-kid=\"1-1-3-2-4-1-1-1\">\n                            </span>\n                            Baja\n                        </span>\n                        <span class=\"text-xs font-semibold text-[#326939]\" data-kid=\"1-1-3-2-4-1-2\">\n                            0–50%\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between rounded-lg bg-[#fcf1ef] px-3 py-3\" data-kid=\"1-1-3-2-4-2\">\n                        <span class=\"flex items-center gap-2 text-sm font-semibold text-[#ae423a]\" data-kid=\"1-1-3-2-4-2-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#c74e46]\" data-kid=\"1-1-3-2-4-2-1-1\">\n                            </span>\n                            Alta\n                        </span>\n                        <span class=\"text-xs font-semibold text-[#a14842]\" data-kid=\"1-1-3-2-4-2-2\">\n                            51–100%\n                        </span>\n                    </div>\n                </div>\n                <p class=\"mt-5 border-t border-[#e7ece8] pt-4 text-xs leading-5 text-[#778279]\" data-kid=\"1-1-3-2-5\">\n                    El dial muestra la escala de clasificación, no el riesgo global de las obras.\n                </p>\n            </aside>\n        </div>\n        <div class=\"mt-5 flex items-start gap-2 text-xs leading-5 text-[#737e77]\" data-kid=\"1-1-4\">\n            <i class=\"bi bi-info-circle shrink-0\" data-kid=\"1-1-4-1\" style=\"width:15px;height:20px\">\n            </i>\n            <p data-kid=\"1-1-4-2\">\n                Propuesta visual con datos ilustrativos. No está conectada a la base de datos.\n            </p>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n const records=[{id:'01',name:'Baja',value:25,color:'#2e7d32',bg:'#edf6ed',icon:'shield-check'},{id:'02',name:'Alta',value:80,color:'#b6433c',bg:'#fcf0ee',icon:'exclamation-triangle'}];\n const actions=(r)=>`<div class=\"flex justify-end gap-1\"><button class=\"row-action\" aria-label=\"Ver detalles del nivel ${r.name}\" title=\"Ver detalles\"><i class=\"bi bi-eye\"></i></button><button class=\"row-action\" aria-label=\"Editar nivel ${r.name}\" title=\"Editar\"><i class=\"bi bi-pencil\"></i></button><button class=\"row-action\" aria-label=\"Desactivar nivel ${r.name}\" title=\"Desactivar\"><i class=\"bi bi-power\"></i></button></div>`;\n const badge=(r)=>`<span class=\"inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 font-semibold\" style=\"color:${r.color};background:${r.bg}\"><i class=\"bi bi-${r.icon}\" style=\"width:15px;height:15px\"></i>${r.name}</span>`;\n const meter=(r)=>`<div class=\"min-w-[70px]\"><span class=\"font-semibold tabular-nums\">${r.value}<span class=\"ml-0.5 text-xs font-normal text-[#7b857e]\">%</span></span><div class=\"mt-2 h-1 w-full max-w-[90px] rounded-full bg-[#edf0ed]\"><div class=\"h-full rounded-full\" style=\"width:${r.value}%;background:${r.color}\"></div></div></div>`;\n document.getElementById('s1-rows').innerHTML=records.map(r=>`<tr class=\"sample-row border-b border-[#e8ece9]\"><td class=\"py-6 pl-6 pr-2 text-xs text-[#7c8980]\">${r.id}</td><td class=\"px-2 py-6\">${badge(r)}</td><td class=\"px-2 py-6\">${meter(r)}</td><td class=\"px-2 py-6 text-xs text-[#4d6b53]\"><span class=\"mr-1 text-[#2e7d32]\">●</span> Activo</td><td class=\"py-6 pr-4 pl-1\">${actions(r)}</td></tr>`).join('');\n document.getElementById('s1-mobile').innerHTML=records.map(r=>`<article class=\"p-5\"><div class=\"mb-4 flex items-center justify-between gap-2\">${badge(r)}<span class=\"text-xs text-[#4d6b53]\">● Activo</span></div><div class=\"flex items-center justify-between gap-3\"><span class=\"text-xs text-[#738077]\">ID ${r.id} · Criticidad</span><strong style=\"color:${r.color}\">${r.value}%</strong></div><div class=\"mt-4 flex items-center justify-between border-t border-[#edf0ed] pt-2\"><span class=\"text-xs text-[#738077]\">Acciones</span>${actions(r)}</div></article>`).join('');\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-16T22:01:03.124634+00:00",
