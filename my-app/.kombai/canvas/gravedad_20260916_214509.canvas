      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n</style>\n<div class=\"min-h-[850px] bg-[#f5f5f9] px-4 py-8 sm:px-8 text-[#566a7f]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Public Sans',sans-serif\">\n    <div class=\"mx-auto max-w-[1180px]\" data-kid=\"1-1\" data-name=\"main content area\">\n        <div class=\"mb-4 text-xs text-[#697887]\" data-kid=\"1-1-1\" data-name=\"page breadcrumb context\">\n            Referencia reconstruida del código · Solo contenido del módulo · Sin conexión a registros\n        </div>\n        <header class=\"relative mb-8 overflow-hidden rounded-2xl border border-[#e2e8f0] bg-white p-6 sm:p-8 shadow-[0_2px_10px_rgba(0,0,0,0.05)]\" data-kid=\"1-1-2\" data-name=\"header section\">\n            <div class=\"pointer-events-none absolute -top-1/2 -right-[10%] h-[280px] w-[280px] rounded-full bg-[#f1c40f]/6\" data-kid=\"1-1-2-1\" data-name=\"decorative circle element\">\n            </div>\n            <div class=\"relative flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-1-2-2\" data-name=\"header content wrapper\">\n                <div data-kid=\"1-1-2-2-1\" data-name=\"header text container\">\n                    <h1 class=\"mb-1 text-[26px] font-bold leading-tight text-[#2e7d32]\" data-kid=\"1-1-2-2-1-1\" data-name=\"section heading\">\n                        <i class=\"bi bi-exclamation-triangle-fill mr-2 inline-block h-7 w-7 text-[#2e7d32]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"alert triangle icon\">\n                        </i>\n                        Gestión de Gravedad de la Obra\n                    </h1>\n                    <p class=\"text-[14.4px] text-[#6c757d]\" data-kid=\"1-1-2-2-1-2\" data-name=\"section description\">\n                        Catálogo de niveles de gravedad para clasificar la criticidad de los proyectos\n                    </p>\n                </div>\n                <button class=\"w-full rounded-full border border-[#2e7d32] bg-[#2e7d32] px-6 py-2 text-sm font-semibold text-white sm:w-auto\" data-kid=\"1-1-2-2-2\" data-name=\"add new level button\">\n                    <i class=\"bi bi-plus-circle mr-1 inline-block h-4 w-4 text-[#f1c40f]\" data-kid=\"1-1-2-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Nuevo Nivel\n                </button>\n            </div>\n        </header>\n        <section class=\"mb-4 rounded-lg bg-white px-6 py-4 text-center shadow-sm\" data-kid=\"1-1-3\" data-name=\"gravity risk chart section\">\n            <div class=\"flex justify-center py-6\" data-kid=\"1-1-3-1\" data-name=\"chart container\">\n                <div class=\"flex h-[220px] w-[220px] items-center justify-center rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.1)]\" data-kid=\"1-1-3-1-1\" data-name=\"circular progress chart\" style=\"background:conic-gradient(#2e7d32 0deg 180deg,#c62828 180deg 360deg)\">\n                    <div class=\"flex h-[180px] w-[180px] flex-col items-center justify-center rounded-full bg-white shadow-[inset_0_2px_8px_rgba(0,0,0,0.06)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"chart inner data container\">\n                        <span class=\"text-5xl font-extrabold leading-none text-[#1a1a1a]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"percentage text\" data-reason=\"text value re-derived by chart rendering logic\">\n                            0%\n                        </span>\n                        <span class=\"mt-1 text-[13.6px] font-semibold tracking-wide uppercase\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"risk category label\">\n                            Bajo\n                        </span>\n                        <span class=\"mt-0.5 text-[11.2px] text-[#6c757d]\" data-kid=\"1-1-3-1-1-1-3\" data-name=\"risk descriptor label\">\n                            Riesgo\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mx-auto mt-2 flex max-w-[220px] justify-between text-[12.8px] text-[#6c757d]\" data-kid=\"1-1-3-2\" data-name=\"legend container\">\n                <span data-kid=\"1-1-3-2-1\" data-name=\"low risk legend item\">\n                    <i class=\"bi bi-shield-check mr-1 inline-block h-3 w-3 text-[#6c757d]\" data-kid=\"1-1-3-2-1-1\" data-name=\"shield icon\">\n                    </i>\n                    0% - 50% Bajo\n                </span>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"high risk legend item\">\n                    <i class=\"bi bi-exclamation-triangle mr-1 inline-block h-3 w-3 text-[#6c757d]\" data-kid=\"1-1-3-2-2-1\" data-name=\"triangle icon\">\n                    </i>\n                    51% - 100% Alto\n                </span>\n            </div>\n        </section>\n        <section class=\"mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#e2e8f0] bg-[#f8fafc] px-6 py-5\" data-kid=\"1-1-4\" data-name=\"search and filter controls section\">\n            <input aria-label=\"Buscar por nivel o criticidad\" class=\"w-full rounded-full border border-[#ced4da] bg-white py-2 pl-4 text-[14.4px] md:w-[350px]\" data-kid=\"1-1-4-1\" data-name=\"search input field\" placeholder=\"🔍 Buscar por nivel o criticidad...\"/>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-4-2\" data-name=\"table actions container\">\n                <span class=\"rounded bg-[#6c757d] px-2 py-1 text-xs font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-4-2-1\" data-name=\"record count badge\" data-reason=\"text updated when records list changes\">\n                    0 registros\n                </span>\n                <button class=\"rounded border border-[#6c757d] px-3 py-1 text-sm text-[#6c757d]\" data-kid=\"1-1-4-2-2\" data-name=\"refresh table button\">\n                    <i class=\"bi bi-arrow-clockwise inline-block h-4 w-4 text-[#6c757d]\" data-kid=\"1-1-4-2-2-1\" data-name=\"refresh icon\">\n                    </i>\n                    Actualizar\n                </button>\n            </div>\n        </section>\n        <section class=\"overflow-hidden rounded-2xl bg-white shadow-sm\" data-kid=\"1-1-5\" data-name=\"data table section\">\n            <div class=\"border-b border-[#e2e8f0] px-5 py-4 font-semibold text-[#1a1a1a]\" data-kid=\"1-1-5-1\" data-name=\"table header\">\n                <i class=\"bi bi-table mr-2 inline-block h-4 w-4 text-[#2e7d32]\" data-kid=\"1-1-5-1-1\" data-name=\"table icon\">\n                </i>\n                Listado de Niveles\n            </div>\n            <div class=\"overflow-x-auto\" data-kid=\"1-1-5-2\" data-name=\"table scroll wrapper\">\n                <table class=\"w-full text-left\" data-kid=\"1-1-5-2-1\" data-name=\"data table\">\n                    <thead class=\"border-b-2 border-[#dee2e6] bg-[#f1f5f9] text-[12.8px] font-bold tracking-[0.5px] text-[#1a1a1a] uppercase\" data-kid=\"1-1-5-2-1-1\" data-name=\"table header row\">\n                        <tr data-kid=\"1-1-5-2-1-1-1\" data-name=\"table header row container\">\n                            <th class=\"px-5 py-4\" data-kid=\"1-1-5-2-1-1-1-1\" data-name=\"id header\">\n                                ID\n                            </th>\n                            <th class=\"px-5 py-4\" data-kid=\"1-1-5-2-1-1-1-2\" data-name=\"level header\">\n                                Nivel de Gravedad\n                            </th>\n                            <th class=\"px-5 py-4\" data-kid=\"1-1-5-2-1-1-1-3\" data-name=\"criticism header\">\n                                Criticidad\n                            </th>\n                            <th class=\"px-5 py-4\" data-kid=\"1-1-5-2-1-1-1-4\" data-name=\"state header\">\n                                Estado\n                            </th>\n                            <th class=\"px-5 py-4\" data-kid=\"1-1-5-2-1-1-1-5\" data-name=\"actions header\">\n                                Acciones\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody data-dynamic=\"true\" data-kid=\"1-1-5-2-1-2\" data-name=\"table body\" data-reason=\"content rendered/populated by data fetching script\">\n                        <tr data-kid=\"1-1-5-2-1-2-1\" data-name=\"empty state row\">\n                            <td class=\"px-5 py-6 text-center text-[#6c757d]\" colspan=\"5\" data-kid=\"1-1-5-2-1-2-1-1\" data-name=\"empty state cell\">\n                                <i class=\"bi bi-inbox mb-2 inline-block h-8 w-8 text-[32px] text-[#6c757d]\" data-kid=\"1-1-5-2-1-2-1-1-1\" data-name=\"inbox icon\">\n                                </i>\n                                <p data-kid=\"1-1-5-2-1-2-1-1-2\" data-name=\"empty state text\">\n                                    No hay niveles de gravedad registrados.\n                                </p>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n    </div>\n</div>\n",
      "comments": [],
