    "var_283b9004dcf3": {
      "type": "variant",
      "label": "03 · Panel compacto con guía horizontal lateral",
      "parentId": "var_13573a7948ae",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n@layer components { .severity-three .bi {display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;color:currentColor} .severity-three .action {display:inline-flex;height:44px;width:44px;align-items:center;justify-content:center;border-radius:6px;color:#657369} .severity-three .action:hover {background:#f0f6f0;color:#2e7d32} }\n</style>\n<div class=\"severity-three min-h-[780px] bg-[#f6f7f8] px-4 py-6 text-[#1a1a1a] sm:px-8 sm:py-10\" data-kid=\"1\" style=\"font-family:'Public Sans',sans-serif\">\n    <main class=\"mx-auto w-full max-w-[1440px] min-w-0\" data-kid=\"1-1\">\n        <div class=\"mb-6 flex items-center gap-2 text-xs text-[#6c7970]\" data-kid=\"1-1-1\">\n            <span class=\"font-bold tracking-[0.12em] text-[#2e7d32]\" data-kid=\"1-1-1-1\">\n                INVISAP\n            </span>\n            <span class=\"mx-1 text-[#b0b9b4]\" data-kid=\"1-1-1-2\">\n                /\n            </span>\n            Catálogos\n            <span class=\"mx-1 text-[#b0b9b4]\" data-kid=\"1-1-1-3\">\n                /\n            </span>\n            Gravedad de obra\n        </div>\n        <header class=\"mb-7 flex flex-wrap items-center justify-between gap-5 border-b border-[#dce3de] pb-6\" data-kid=\"1-1-2\">\n            <div class=\"min-w-0\" data-kid=\"1-1-2-1\">\n                <h1 class=\"text-[clamp(1.4rem,2.3vw,1.9rem)] font-bold leading-tight tracking-[-0.035em]\" data-kid=\"1-1-2-1-1\">\n                    Gestión de Gravedad de la Obra\n                </h1>\n                <p class=\"mt-2 text-sm leading-6 text-[#69786f]\" data-kid=\"1-1-2-1-2\">\n                    Catálogo de niveles para clasificar la criticidad de los proyectos.\n                </p>\n            </div>\n            <button class=\"flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#2e7d32] px-5 py-3 text-sm font-semibold text-white sm:w-auto\" data-kid=\"1-1-2-2\">\n                <i class=\"bi bi-plus-lg\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Nuevo nivel\n            </button>\n        </header>\n        <div class=\"grid min-w-0 grid-cols-1 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_330px]\" data-kid=\"1-1-3\">\n            <section class=\"min-w-0 overflow-hidden rounded-xl border border-[#dde5df] bg-white\" data-kid=\"1-1-3-1\">\n                <div class=\"flex flex-wrap items-center justify-between gap-3 px-5 py-5\" data-kid=\"1-1-3-1-1\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-1-1\">\n                        <h2 class=\"text-base font-bold\" data-kid=\"1-1-3-1-1-1-1\">\n                            Listado de Niveles\n                        </h2>\n                        <span class=\"rounded-md border border-[#e4e9e5] px-2 py-0.5 text-xs text-[#77857a]\" data-kid=\"1-1-3-1-1-1-2\">\n                            2\n                        </span>\n                    </div>\n                    <span class=\"text-xs text-[#77857a]\" data-kid=\"1-1-3-1-1-2\">\n                        Ejemplo de registros\n                    </span>\n                </div>\n                <div class=\"flex flex-wrap items-end gap-3 border-y border-[#e6ebe7] bg-[#fafcfb] px-5 py-4\" data-kid=\"1-1-3-1-2\">\n                    <div class=\"min-w-0 grow\" data-kid=\"1-1-3-1-2-1\">\n                        <label class=\"mb-2 block text-xs font-semibold text-[#66776b]\" data-kid=\"1-1-3-1-2-1-1\" for=\"s3-search\">\n                            Buscar nivel o criticidad\n                        </label>\n                        <div class=\"flex h-11 items-center gap-2 rounded-md border border-[#dce4de] bg-white px-3 text-[#728177]\" data-kid=\"1-1-3-1-2-1-2\">\n                            <i class=\"bi bi-search shrink-0\" data-kid=\"1-1-3-1-2-1-2-1\">\n                            </i>\n                            <input class=\"min-w-0 w-full bg-transparent text-sm outline-hidden\" data-kid=\"1-1-3-1-2-1-2-2\" id=\"s3-search\" placeholder=\"Escribe para buscar…\"/>\n                        </div>\n                    </div>\n                    <button class=\"flex h-11 items-center gap-2 rounded-md border border-[#dce4de] bg-white px-3 text-sm text-[#526458]\" data-kid=\"1-1-3-1-2-2\">\n                        <i class=\"bi bi-arrow-clockwise\" data-kid=\"1-1-3-1-2-2-1\">\n                        </i>\n                        Actualizar\n                    </button>\n                </div>\n                <div class=\"hidden sm:block\" data-kid=\"1-1-3-1-3\">\n                    <table class=\"w-full text-left text-sm\" data-kid=\"1-1-3-1-3-1\">\n                        <thead class=\"text-[11px] font-semibold tracking-[0.04em] text-[#7a897e] uppercase\" data-kid=\"1-1-3-1-3-1-1\">\n                            <tr data-kid=\"1-1-3-1-3-1-1-1\">\n                                <th class=\"py-4 pl-5 pr-2\" data-kid=\"1-1-3-1-3-1-1-1-1\">\n                                    ID\n                                </th>\n                                <th class=\"px-2 py-4\" data-kid=\"1-1-3-1-3-1-1-1-2\">\n                                    Nivel de gravedad\n                                </th>\n                                <th class=\"px-2 py-4\" data-kid=\"1-1-3-1-3-1-1-1-3\">\n                                    Criticidad\n                                </th>\n                                <th class=\"px-2 py-4\" data-kid=\"1-1-3-1-3-1-1-1-4\">\n                                    Estado\n                                </th>\n                                <th class=\"py-4 pr-5 pl-2 text-right\" data-kid=\"1-1-3-1-3-1-1-1-5\">\n                                    Acciones\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-dynamic=\"true\" data-kid=\"1-1-3-1-3-1-2\" data-name=\"table rows container\" data-reason=\"table rows generated and injected by script\" id=\"s3-rows\">\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"divide-y divide-[#e6ebe7] sm:hidden\" data-dynamic=\"true\" data-kid=\"1-1-3-1-4\" data-name=\"mobile list container\" data-reason=\"list items generated and injected by script\" id=\"s3-mobile\">\n                </div>\n                <div class=\"border-t border-[#e6ebe7] px-5 py-4 text-xs text-[#78887b]\" data-kid=\"1-1-3-1-5\">\n                    2 registros de ejemplo · Porcentajes de criticidad de 0 a 100\n                </div>\n            </section>\n            <aside class=\"min-w-0 rounded-xl border border-[#dce5de] bg-white p-5\" data-kid=\"1-1-3-2\">\n                <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-1-3-2-1\">\n                    <h2 class=\"text-sm font-bold text-[#2e7d32]\" data-kid=\"1-1-3-2-1-1\">\n                        Guía de clasificación\n                    </h2>\n                    <i class=\"bi bi-info-circle text-[#718077]\" data-kid=\"1-1-3-2-1-2\">\n                    </i>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-5\" data-kid=\"1-1-3-2-2\">\n                    <div class=\"relative flex h-[124px] w-[124px] shrink-0 items-center justify-center rounded-full\" data-kid=\"1-1-3-2-2-1\" style=\"background:conic-gradient(from 0deg,#c34d46 0deg 178deg,#fff 178deg 182deg,#2e7d32 182deg 358deg,#fff 358deg)\">\n                        <div class=\"flex h-[104px] w-[104px] flex-col items-center justify-center rounded-full bg-white\" data-kid=\"1-1-3-2-2-1-1\">\n                            <strong class=\"text-[30px] font-bold leading-none\" data-kid=\"1-1-3-2-2-1-1-1\">\n                                2\n                            </strong>\n                            <span class=\"mt-1.5 text-[11px] text-[#6e8172]\" data-kid=\"1-1-3-2-2-1-1-2\">\n                                niveles\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"min-w-0 grow space-y-5\" data-kid=\"1-1-3-2-2-2\">\n                        <div data-kid=\"1-1-3-2-2-2-1\">\n                            <div class=\"flex items-center gap-2 text-sm font-bold text-[#2e7d32]\" data-kid=\"1-1-3-2-2-2-1-1\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#2e7d32]\" data-kid=\"1-1-3-2-2-2-1-1-1\">\n                                </span>\n                                Baja\n                            </div>\n                            <p class=\"mt-1 pl-4 text-xs text-[#76877a]\" data-kid=\"1-1-3-2-2-2-1-2\">\n                                0–50%\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-3-2-2-2-2\">\n                            <div class=\"flex items-center gap-2 text-sm font-bold text-[#b84640]\" data-kid=\"1-1-3-2-2-2-2-1\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#c34d46]\" data-kid=\"1-1-3-2-2-2-2-1-1\">\n                                </span>\n                                Alta\n                            </div>\n                            <p class=\"mt-1 pl-4 text-xs text-[#76877a]\" data-kid=\"1-1-3-2-2-2-2-2\">\n                                51–100%\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-6 border-t border-[#e6ebe7] pt-4\" data-kid=\"1-1-3-2-3\">\n                    <h3 class=\"text-xs font-semibold text-[#455f4d]\" data-kid=\"1-1-3-2-3-1\">\n                        ¿Qué muestra el dial?\n                    </h3>\n                    <p class=\"mt-2 text-xs leading-5 text-[#77867b]\" data-kid=\"1-1-3-2-3-2\">\n                        Los dos rangos de gravedad disponibles. Es una guía, no una medición del riesgo de tus obras.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <div class=\"mt-5 flex items-start gap-2 text-xs leading-5 text-[#77867b]\" data-kid=\"1-1-4\">\n            <i class=\"bi bi-info-circle shrink-0\" data-kid=\"1-1-4-1\" style=\"width:15px;height:20px\">\n            </i>\n            <p data-kid=\"1-1-4-2\">\n                Vista de diseño con datos ilustrativos, sin conexión a la base de datos.\n            </p>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n const records=[{id:'01',name:'Baja',value:25,color:'#2e7d32',bg:'#eff7ef'},{id:'02',name:'Alta',value:80,color:'#b84640',bg:'#fdf1ef'}];\n const acts=r=>`<div class=\"flex justify-end gap-1\"><button class=\"action\" title=\"Ver detalles\" aria-label=\"Ver detalles del nivel ${r.name}\"><i class=\"bi bi-eye\"></i></button><button class=\"action\" title=\"Editar\" aria-label=\"Editar nivel ${r.name}\"><i class=\"bi bi-pencil\"></i></button><button class=\"action\" title=\"Desactivar\" aria-label=\"Desactivar nivel ${r.name}\"><i class=\"bi bi-power\"></i></button></div>`;\n const badge=r=>`<span class=\"inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-sm font-semibold\" style=\"background:${r.bg};color:${r.color}\"><span class=\"h-1.5 w-1.5 rounded-full\" style=\"background:${r.color}\"></span>${r.name}</span>`;\n document.getElementById('s3-rows').innerHTML=records.map(r=>`<tr class=\"border-t border-[#eef1ef]\"><td class=\"py-5 pl-5 pr-2 text-xs text-[#859188]\">${r.id}</td><td class=\"px-2 py-5\">${badge(r)}</td><td class=\"px-2 py-5\"><span class=\"font-semibold tabular-nums\">${r.value}%</span><div class=\"mt-2 h-1 w-20 overflow-hidden rounded-full bg-[#eef2ef]\"><div class=\"h-full rounded-full\" style=\"width:${r.value}%;background:${r.color}\"></div></div></td><td class=\"px-2 py-5 text-xs text-[#51725a]\">Activo</td><td class=\"py-5 pr-3 pl-1\">${acts(r)}</td></tr>`).join('');\n document.getElementById('s3-mobile').innerHTML=records.map(r=>`<article class=\"p-5\"><div class=\"flex items-center justify-between gap-2\">${badge(r)}<span class=\"text-xs text-[#51725a]\">Activo</span></div><div class=\"my-4 flex items-center justify-between gap-3\"><span class=\"text-xs text-[#7b8c80]\">ID ${r.id} · Criticidad</span><strong style=\"color:${r.color}\">${r.value}%</strong></div><div class=\"flex items-center justify-between border-t border-[#eaf0ec] pt-2\"><span class=\"text-xs text-[#7b8c80]\">Acciones</span>${acts(r)}</div></article>`).join('');\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-16T22:01:15.137682+00:00",
      "modified": "2026-09-16T22:01:18.110787+00:00",
      "id": "var_283b9004dcf3"
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}