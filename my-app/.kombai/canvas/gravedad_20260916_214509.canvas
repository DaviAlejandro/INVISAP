    "var_9c5c6bfe96f9": {
      "type": "variant",
      "label": "02 · Guía a la izquierda y listado integrado",
      "parentId": "var_13573a7948ae",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n@layer components { .severity-two .bi {display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;color:currentColor} .severity-two .act {display:inline-flex;height:44px;width:44px;align-items:center;justify-content:center;border-radius:8px;color:#6a776b} .severity-two .act:hover {background:#f1f5ee;color:#2e7d32} }\n</style>\n<div class=\"severity-two min-h-[780px] bg-[#f5f5f9] px-4 py-6 text-[#1a1a1a] sm:px-8 sm:py-10\" data-kid=\"1\" style=\"font-family:'Public Sans',sans-serif\">\n    <main class=\"mx-auto w-full max-w-[1440px] min-w-0\" data-kid=\"1-1\">\n        <div class=\"mb-6 flex items-center gap-2 text-xs text-[#727a70]\" data-kid=\"1-1-1\">\n            <span class=\"font-bold tracking-[0.12em] text-[#2e7d32]\" data-kid=\"1-1-1-1\">\n                INVISAP\n            </span>\n            <span class=\"mx-1 text-[#b1b9ad]\" data-kid=\"1-1-1-2\">\n                /\n            </span>\n            Catálogos\n            <span class=\"mx-1 text-[#b1b9ad]\" data-kid=\"1-1-1-3\">\n                /\n            </span>\n            Gravedad de obra\n        </div>\n        <header class=\"mb-6 rounded-2xl border border-[#dfe5db] bg-white p-5 sm:p-7\" data-kid=\"1-1-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-5\" data-kid=\"1-1-2-1\">\n                <div class=\"flex min-w-0 flex-1 items-start gap-4\" data-kid=\"1-1-2-1-1\">\n                    <span class=\"hidden h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#eef5e9] text-[#2e7d32] sm:flex\" data-kid=\"1-1-2-1-1-1\">\n                        <i class=\"bi bi-exclamation-triangle\" data-kid=\"1-1-2-1-1-1-1\" style=\"width:24px;height:24px;font-size:24px\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-2\">\n                        <h1 class=\"text-[clamp(1.35rem,2.2vw,1.8rem)] font-bold leading-tight tracking-[-0.03em]\" data-kid=\"1-1-2-1-1-2-1\">\n                            Gestión de Gravedad de la Obra\n                        </h1>\n                        <p class=\"mt-2 text-sm leading-6 text-[#6c7767]\" data-kid=\"1-1-2-1-1-2-2\">\n                            Clasifica la criticidad de tus proyectos y administra sus niveles.\n                        </p>\n                    </div>\n                </div>\n                <button class=\"flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#2e7d32] px-5 py-3 text-sm font-semibold text-white sm:w-auto\" data-kid=\"1-1-2-1-2\">\n                    <i class=\"bi bi-plus-lg\" data-kid=\"1-1-2-1-2-1\">\n                    </i>\n                    Nuevo nivel\n                </button>\n            </div>\n        </header>\n        <div class=\"grid min-w-0 grid-cols-1 items-stretch overflow-hidden rounded-2xl border border-[#dce3d7] bg-white lg:grid-cols-[260px_minmax(0,1fr)]\" data-kid=\"1-1-3\">\n            <aside class=\"order-2 min-w-0 border-t border-[#dce3d7] bg-[#f4f7ef] p-6 lg:order-1 lg:border-t-0 lg:border-r\" data-kid=\"1-1-3-1\">\n                <div class=\"flex items-center gap-2 text-[#2e7d32]\" data-kid=\"1-1-3-1-1\">\n                    <i class=\"bi bi-speedometer2\" data-kid=\"1-1-3-1-1-1\">\n                    </i>\n                    <h2 class=\"text-sm font-bold\" data-kid=\"1-1-3-1-1-2\">\n                        Escala de gravedad\n                    </h2>\n                </div>\n                <p class=\"mt-2 text-xs leading-5 text-[#68765f]\" data-kid=\"1-1-3-1-2\">\n                    Dos niveles de criticidad.\n                </p>\n                <div class=\"my-4 flex justify-center\" data-kid=\"1-1-3-1-3\">\n                    <div class=\"flex h-[144px] w-[144px] items-center justify-center rounded-full\" data-kid=\"1-1-3-1-3-1\" style=\"background:conic-gradient(#c05a43 0deg 177deg,#f4f7ef 177deg 183deg,#2e7d32 183deg 357deg,#f4f7ef 357deg)\">\n                        <div class=\"flex h-[120px] w-[120px] flex-col items-center justify-center rounded-full bg-[#f4f7ef]\" data-kid=\"1-1-3-1-3-1-1\">\n                            <strong class=\"text-[26px] font-bold tracking-tight text-[#294331]\" data-kid=\"1-1-3-1-3-1-1-1\">\n                                0–100\n                                <span class=\"text-sm\" data-kid=\"1-1-3-1-3-1-1-1-1\">\n                                    %\n                                </span>\n                            </strong>\n                            <span class=\"mt-1 text-[11px] text-[#68765f]\" data-kid=\"1-1-3-1-3-1-1-2\">\n                                Escala de criticidad\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-1-3-1-4\">\n                    <div class=\"flex items-center gap-3 border-b border-[#dfe6d8] pb-3\" data-kid=\"1-1-3-1-4-1\">\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#e6efdf] text-[#2e7d32]\" data-kid=\"1-1-3-1-4-1-1\">\n                            <i class=\"bi bi-shield-check\" data-kid=\"1-1-3-1-4-1-1-1\">\n                            </i>\n                        </span>\n                        <div class=\"grow text-sm font-bold text-[#315a36]\" data-kid=\"1-1-3-1-4-1-2\">\n                            Baja\n                        </div>\n                        <span class=\"text-xs font-semibold text-[#55684b]\" data-kid=\"1-1-3-1-4-1-3\">\n                            0–50%\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-3-1-4-2\">\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#f5e8df] text-[#af4e39]\" data-kid=\"1-1-3-1-4-2-1\">\n                            <i class=\"bi bi-exclamation-triangle\" data-kid=\"1-1-3-1-4-2-1-1\">\n                            </i>\n                        </span>\n                        <div class=\"grow text-sm font-bold text-[#974b37]\" data-kid=\"1-1-3-1-4-2-2\">\n                            Alta\n                        </div>\n                        <span class=\"text-xs font-semibold text-[#75634c]\" data-kid=\"1-1-3-1-4-2-3\">\n                            51–100%\n                        </span>\n                    </div>\n                </div>\n                <p class=\"mt-4 border-l-2 border-[#d3ac2d] pl-3 text-[11px] leading-5 text-[#67735e]\" data-kid=\"1-1-3-1-5\">\n                    Guía de clasificación, no una medición del riesgo de las obras.\n                </p>\n            </aside>\n            <section class=\"order-1 min-w-0 lg:order-2\" data-kid=\"1-1-3-2\">\n                <div class=\"flex flex-wrap items-center justify-between gap-2 px-5 pt-6 sm:px-7\" data-kid=\"1-1-3-2-1\">\n                    <h2 class=\"text-lg font-bold tracking-tight\" data-kid=\"1-1-3-2-1-1\">\n                        Listado de Niveles\n                        <span class=\"ml-2 text-sm font-normal text-[#84907b]\" data-kid=\"1-1-3-2-1-1-1\">\n                            (2)\n                        </span>\n                    </h2>\n                    <span class=\"text-xs text-[#7b8574]\" data-kid=\"1-1-3-2-1-2\">\n                        Datos ilustrativos\n                    </span>\n                </div>\n                <div class=\"flex flex-wrap items-end gap-3 px-5 py-5 sm:px-7\" data-kid=\"1-1-3-2-2\">\n                    <div class=\"min-w-0 grow\" data-kid=\"1-1-3-2-2-1\">\n                        <label class=\"mb-2 block text-xs font-medium text-[#627158]\" data-kid=\"1-1-3-2-2-1-1\" for=\"s2-search\">\n                            Buscar en el listado\n                        </label>\n                        <div class=\"flex h-11 items-center gap-2 rounded-lg border border-[#d9e1d3] bg-[#fcfdfb] px-3 text-[#74846c]\" data-kid=\"1-1-3-2-2-1-2\">\n                            <i class=\"bi bi-search shrink-0\" data-kid=\"1-1-3-2-2-1-2-1\">\n                            </i>\n                            <input class=\"w-full min-w-0 bg-transparent text-sm outline-hidden\" data-kid=\"1-1-3-2-2-1-2-2\" id=\"s2-search\" placeholder=\"Nivel o porcentaje…\"/>\n                        </div>\n                    </div>\n                    <button class=\"flex h-11 items-center gap-2 rounded-lg border border-[#d9e1d3] px-3 text-sm font-medium text-[#53644a]\" data-kid=\"1-1-3-2-2-2\">\n                        <i class=\"bi bi-arrow-clockwise\" data-kid=\"1-1-3-2-2-2-1\">\n                        </i>\n                        Actualizar\n                    </button>\n                </div>\n                <div class=\"hidden sm:block\" data-kid=\"1-1-3-2-3\">\n                    <table class=\"w-full text-left text-sm\" data-kid=\"1-1-3-2-3-1\">\n                        <thead class=\"border-y border-[#e7ece2] bg-[#fafbf8] text-[11px] font-semibold text-[#718067]\" data-kid=\"1-1-3-2-3-1-1\">\n                            <tr data-kid=\"1-1-3-2-3-1-1-1\">\n                                <th class=\"py-3 pl-7 pr-2\" data-kid=\"1-1-3-2-3-1-1-1-1\">\n                                    ID\n                                </th>\n                                <th class=\"p-2\" data-kid=\"1-1-3-2-3-1-1-1-2\">\n                                    NIVEL DE GRAVEDAD\n                                </th>\n                                <th class=\"p-2\" data-kid=\"1-1-3-2-3-1-1-1-3\">\n                                    CRITICIDAD\n                                </th>\n                                <th class=\"p-2\" data-kid=\"1-1-3-2-3-1-1-1-4\">\n                                    ESTADO\n                                </th>\n                                <th class=\"py-3 pl-2 pr-7 text-right\" data-kid=\"1-1-3-2-3-1-1-1-5\">\n                                    ACCIONES\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1-2\" data-name=\"table rows container\" data-reason=\"table rows rendered by script from data array\" id=\"s2-rows\">\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"divide-y divide-[#e7ece2] sm:hidden\" data-dynamic=\"true\" data-kid=\"1-1-3-2-4\" data-name=\"mobile list container\" data-reason=\"list items rendered by script from data array\" id=\"s2-mobile\">\n                </div>\n                <div class=\"mx-5 flex flex-wrap justify-between gap-2 border-t border-[#e7ece2] py-5 text-xs text-[#74826a] sm:mx-7\" data-kid=\"1-1-3-2-5\">\n                    <span data-kid=\"1-1-3-2-5-1\">\n                        Mostrando 2 registros de ejemplo\n                    </span>\n                    <span data-kid=\"1-1-3-2-5-2\">\n                        Escala: 0–100%\n                    </span>\n                </div>\n            </section>\n        </div>\n        <p class=\"mt-5 text-xs leading-5 text-[#7a8473]\" data-kid=\"1-1-4\">\n            Propuesta visual · Los registros mostrados son de ejemplo y no provienen de la base de datos.\n        </p>\n    </main>\n</div>\n<script>\n    (() => {\n const rows=[{id:'01',name:'Baja',value:25,color:'#2e7d32',bg:'#edf4e8',icon:'shield-check'},{id:'02',name:'Alta',value:80,color:'#ad4b39',bg:'#fcf0e9',icon:'exclamation-triangle'}];\n const acts=r=>`<div class=\"flex justify-end gap-1\"><button class=\"act\" aria-label=\"Ver detalles del nivel ${r.name}\" title=\"Ver detalles\"><i class=\"bi bi-eye\"></i></button><button class=\"act\" aria-label=\"Editar nivel ${r.name}\" title=\"Editar\"><i class=\"bi bi-pencil\"></i></button><button class=\"act\" aria-label=\"Desactivar nivel ${r.name}\" title=\"Desactivar\"><i class=\"bi bi-power\"></i></button></div>`;\n const title=r=>`<span class=\"inline-flex items-center gap-2 font-semibold\" style=\"color:${r.color}\"><span class=\"flex h-9 w-9 items-center justify-center rounded-lg\" style=\"background:${r.bg}\"><i class=\"bi bi-${r.icon}\"></i></span>${r.name}</span>`;\n document.getElementById('s2-rows').innerHTML=rows.map(r=>`<tr class=\"border-b border-[#edf0e9] last:border-0\"><td class=\"py-7 pl-7 pr-2 text-xs text-[#819078]\">${r.id}</td><td class=\"p-2\">${title(r)}</td><td class=\"p-2\"><strong class=\"tabular-nums\">${r.value}%</strong><div class=\"mt-2 h-1.5 w-20 rounded-full bg-[#eff2eb]\"><div class=\"h-full rounded-full\" style=\"width:${r.value}%;background:${r.color}\"></div></div></td><td class=\"p-2\"><span class=\"rounded-md bg-[#f0f5ea] px-2 py-1 text-xs font-medium text-[#587245]\">Activo</span></td><td class=\"py-5 pl-1 pr-5\">${acts(r)}</td></tr>`).join('');\n document.getElementById('s2-mobile').innerHTML=rows.map(r=>`<article class=\"p-5\"><div class=\"flex flex-wrap items-center justify-between gap-2\">${title(r)}<span class=\"text-xs text-[#587245]\">Activo · ID ${r.id}</span></div><div class=\"my-4 flex items-center justify-between rounded-lg bg-[#f7f9f3] px-3 py-3\"><span class=\"text-xs text-[#697d5b]\">Criticidad</span><strong style=\"color:${r.color}\">${r.value}%</strong></div><div class=\"flex items-center justify-between\"><span class=\"text-xs text-[#819078]\">Acciones</span>${acts(r)}</div></article>`).join('');\n})();\n</script>\n",
